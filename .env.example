# All variables are optional. With none set, images come from Pollinations
# (keyless text->image) and the style/product descriptions use deterministic
# fallbacks derived from the reference count and product filenames.

# Vision + copywriting (OpenRouter). Enables real captioning of references and
# products and AI-written headline/caption per post.
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Second image provider (Together AI FLUX.1 schnell). Used as failover after Pollinations.
TOGETHER_API_KEY=

# Add an offline placeholder provider at the end of the chain. Off by default so
# a product whose real providers all fail is reported as failed, not faked.
ENABLE_MOCK_PROVIDER=false

# Comma-separated product filenames the primary provider refuses to generate.
# Demo hook for partial failure + failover, e.g. GEN_FORCE_FAIL=bottle.jpg
GEN_FORCE_FAIL=

# Limits
MAX_CONCURRENCY=3        # products generated at once
MAX_PRODUCTS=12          # products per batch
MAX_FILE_BYTES=10485760  # per uploaded image (10 MB)
BATCH_TTL_MS=3600000     # in-memory batch lifetime (1 h)
