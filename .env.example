# All variables are optional, but the app only does its real job with GEMINI_API_KEY.
#
# With GEMINI_API_KEY: the product and reference pixels go to an image-to-image
# model, and the same key powers reference captioning, product description and
# social copy. One key, full pipeline.
#
# With no keys: images come from Pollinations (keyless text->image) driven by a
# fixed style template and a subject derived from the product filename. The
# uploaded pixels are NOT used. Good for a dry run of the pipeline, not for output.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image   # or gemini-3-pro-image / gemini-3.1-flash-lite-image
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite     # vision captioning + copywriting

# Alternative vision/copy client when GEMINI_API_KEY is absent (OpenRouter).
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# Extra text->image provider (Together AI FLUX.1 schnell), after Pollinations in the chain.
TOGETHER_API_KEY=

# Add an offline placeholder provider at the end of the chain. Off by default so
# a product whose real providers all fail is reported as failed, not faked.
ENABLE_MOCK_PROVIDER=false

# Comma-separated product filenames the primary provider refuses to generate.
# Demo hook for partial failure + failover, e.g. GEN_FORCE_FAIL=bottle.jpg
GEN_FORCE_FAIL=

# Limits
MAX_CONCURRENCY=3        # products generated at once
MAX_PRODUCTS=12          # products per batch
MAX_FILE_BYTES=10485760  # per uploaded image (10 MB)
BATCH_TTL_MS=3600000     # in-memory batch lifetime (1 h)
